<?xml version="1.0" encoding="UTF-8"?>
<window type="window" id="1190">
    <defaultcontrol always="true">101</defaultcontrol>
    <onload>SetProperty(MediaNoche.SeriesPlaylist,special://skin/extras/playlists/medianoche/series-completas.xsp)</onload>
    <onunload>ClearProperty(MediaNoche.SeriesPlaylist)</onunload>
    <controls>
        <control type="image">
            <width>1920</width><height>1080</height>
            <texture colordiffuse="FF080F18">common/white.png</texture>
        </control>
        <control type="label">
            <left>70</left><top>65</top><width>1700</width><height>80</height>
            <font>SmallBold</font><textcolor>FFE5BC70</textcolor><label>Series estrenos</label>
        </control>
        <control type="image">
            <left>70</left><top>160</top><width>1780</width><height>2</height>
            <texture colordiffuse="FF78B8E8">common/white.png</texture>
        </control>
        <control type="button" id="101">
            <left>70</left><top>230</top><width>350</width><height>88</height>
            <font>Tiny</font><textcolor>FFFFFFFF</textcolor><focusedcolor>FF101820</focusedcolor>
            <texturenofocus colordiffuse="FF182331">common/white.png</texturenofocus>
            <texturefocus colordiffuse="FFE5BC70">common/white.png</texturefocus>
            <label>Series completas</label>
            <onfocus>SetProperty(MediaNoche.SeriesPlaylist,special://skin/extras/playlists/medianoche/series-completas.xsp)</onfocus>
            <onclick>ActivateWindow(Videos,special://skin/extras/playlists/medianoche/series-completas.xsp,return)</onclick>
            <onup>102</onup><ondown>102</ondown><onright>50</onright><onleft>101</onleft>
        </control>
        <control type="button" id="102">
            <left>70</left><top>340</top><width>350</width><height>88</height>
            <font>Tiny</font><textcolor>FFFFFFFF</textcolor><focusedcolor>FF101820</focusedcolor>
            <texturenofocus colordiffuse="FF182331">common/white.png</texturenofocus>
            <texturefocus colordiffuse="FFE5BC70">common/white.png</texturefocus>
            <label>Episodios recientes</label>
            <onfocus>SetProperty(MediaNoche.SeriesPlaylist,special://skin/extras/playlists/medianoche/episodios-recientes.xsp)</onfocus>
            <onclick>ActivateWindow(Videos,special://skin/extras/playlists/medianoche/episodios-recientes.xsp,return)</onclick>
            <onup>101</onup><ondown>101</ondown><onright>50</onright><onleft>102</onleft>
        </control>
        <control type="label">
            <left>470</left><top>200</top><width>1350</width><height>60</height>
            <font>Small</font><textcolor>FFFFFFFF</textcolor>
            <label>Añadidas recientemente</label>
        </control>
        <control type="list" id="50">
            <left>470</left><top>290</top><width>1350</width><height>480</height>
            <orientation>horizontal</orientation>
            <onleft condition="Container(50).Position(0)">101</onleft>
            <onup>101</onup><ondown>102</ondown><onback>101</onback>
            <onclick condition="String.IsEqual(Container(50).ListItem.DBType,tvshow)">ActivateWindow(Videos,videodb://tvshows/titles/$INFO[Container(50).ListItem.DBID]/,return)</onclick>
            <onclick condition="String.IsEqual(Container(50).ListItem.DBType,episode)">PlayMedia($ESCINFO[Container(50).ListItem.FileNameAndPath])</onclick>
            <itemlayout width="270" height="480">
                <control type="image">
                    <left>10</left><top>10</top><width>240</width><height>360</height>
                    <aspectratio>keep</aspectratio><texture fallback="DefaultVideo.png">$INFO[ListItem.Art(poster)]</texture>
                </control>
                <control type="label">
                    <left>10</left><top>385</top><width>240</width><height>75</height>
                    <font>Tiny</font><textcolor>FFFFFFFF</textcolor><label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="270" height="480">
                <control type="image">
                    <left>5</left><top>5</top><width>250</width><height>370</height>
                    <texture colordiffuse="FFE5BC70">common/white.png</texture>
                </control>
                <control type="image">
                    <left>10</left><top>10</top><width>240</width><height>360</height>
                    <aspectratio>keep</aspectratio><texture fallback="DefaultVideo.png">$INFO[ListItem.Art(poster)]</texture>
                </control>
                <control type="label">
                    <left>10</left><top>385</top><width>240</width><height>75</height>
                    <font>Tiny</font><textcolor>FFE5BC70</textcolor><scroll>true</scroll><label>$INFO[ListItem.Label]</label>
                </control>
            </focusedlayout>
            <content target="videos">$INFO[Window.Property(MediaNoche.SeriesPlaylist)]</content>
        </control>
        <control type="label">
            <left>470</left><top>800</top><width>1350</width><height>100</height>
            <font>Tiny</font><textcolor>FFFFFFFF</textcolor><wrapmultiline>true</wrapmultiline>
            <visible>!Container(50).IsUpdating + Integer.IsEqual(Container(50).NumItems,0)</visible>
            <label>No hay resultados en esta categoría. Series completas necesita el estado de serie finalizada en Kodi.</label>
        </control>
    </controls>
</window>
